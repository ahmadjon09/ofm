# Namuna .env fayli — o'z qiymatlaringiz bilan nusxa oling: cp .env.example .env
# (majburiy o'zgaruvchilar: MONGO_URI, JWT_SECRET, JWT_REFRESH_SECRET, PORT)

MONGO_URI=mongodb://127.0.0.1:27017/ofm
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Dashboard keshi (sekund)
DASHBOARD_CACHE_TTL=30

# DB kvotasi (MB)
DB_QUOTA_MB=512

# Ish vaqti mintaqasi: oy/kun chegaralari shu bo'yicha hisoblanadi.
# Daqiqalarda, UTC ga nisbatan. 300 = UTC+5 (Toshkent) — standart qiymat.
# Nega kerak: server UTC da ishlasa ham, kechqurun (Toshkent vaqti bilan
# 00:00 dan keyin) kiritilgan operatsiyalar to'g'ri oyga tushishi uchun.
TIMEZONE_OFFSET_MINUTES=300
